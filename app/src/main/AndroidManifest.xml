<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- System permissions for performance monitoring, overlay, foreground services -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Queries to find installed games and launcher apps without querying all packages unconditionally -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.GAME" />
        </intent>
        <!-- Well-known game package definitions for enhanced detection -->
        <package android:name="com.dts.freefireth" />
        <package android:name="com.dts.freefiremax" />
        <package android:name="com.tencent.ig" />
        <package android:name="com.mobile.legends" />
        <package android:name="com.pubg.imobile" />
        <package android:name="com.miHoYo.GenshinImpact" />
        <package android:name="com.roblox.client" />
        <package android:name="com.epicgames.portal" />
        <!-- Shizuku Privileged System Access Package Queries -->
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="moe.shizuku.redirect" />
    </queries>

    <application
        android:name=".XsdBoostApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Translucent Screenshot Consent Proxy Activity -->
        <activity
            android:name=".core.system.screenshot.ScreenshotActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:theme="@style/Theme.XsdTranslucent" />

        <!-- Dedicated UsageStats Foreground Game Detection Service -->
        <service
            android:name=".core.system.games.GameDetectionForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="UsageStats foreground game detection for in-game booster handle" />
        </service>

        <!-- Floating In-Game Booster Overlay Service -->
        <service
            android:name=".core.system.overlay.FloatingOverlayService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Gaming performance HUD and floating system monitor" />
        </service>

        <!-- Floating Crosshair Overlay Service -->
        <service
            android:name=".core.system.overlay.FloatingCrosshairService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Precision aiming assistant HUD overlay" />
        </service>

        <!-- MediaProjection One-Shot Screenshot Service -->
        <service
            android:name=".core.system.screenshot.ScreenshotService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Shizuku Binder IPC Provider -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>

</manifest>
